# ── Production Backend (multi-stage) ──────────────────────────
# Stage 1: Build — installs ALL deps for TypeScript + Prisma compilation
FROM node:20-alpine AS builder

# Build tools needed for argon2 native compilation on Alpine
RUN apk add --no-cache openssl python3 make gcc g++

WORKDIR /app

# Install ALL dependencies (dev included — needed for tsc and prisma CLI)
COPY package*.json ./
RUN npm ci

# Copy source and build
COPY . .
RUN npx prisma generate
RUN npx tsc --project tsconfig.json

# ── Stage 2: Production runtime ──────────────────────────────
FROM node:20-alpine

# argon2 still needs build tools at install time (native addon)
RUN apk add --no-cache openssl python3 make gcc g++

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev

# Remove build tools after argon2 is compiled (slims the image)
RUN apk del python3 make gcc g++

# Copy compiled output from builder stage
COPY --from=builder /app/dist ./dist

# Copy generated Prisma client
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# tsconfig-paths needs a tsconfig.json at runtime for @api/* path aliases.
# The prod version uses baseUrl=dist since compiled output lives there.
COPY --from=builder /app/tsconfig.prod.json ./tsconfig.json

EXPOSE 3000

CMD ["node", "-r", "tsconfig-paths/register", "dist/api/index.js"]
