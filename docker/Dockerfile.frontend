# ── Production Frontend Builder ────────────────────────────────
FROM node:20-alpine

# Build tools needed for argon2 native compilation (shared dependency)
RUN apk add --no-cache python3 make gcc g++

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx vite build

# dist/ is the output — mounted as a volume by docker-compose
